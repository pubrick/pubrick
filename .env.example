# Copy to .env and fill in. Compose refuses to start (leaves the container unable
# to launch at all) if the two secrets below are unset; the api additionally
# refuses to boot if either is *set* to one of the placeholder values shipped in
# this repository — see BETTER_AUTH_SECRET/APP_ENCRYPTION_KEY below. Neither
# guard makes an install "safe by default": both only fire once you look at
# `docker compose logs api`, so treat the placeholders below as required to
# change, not as something a missing error message will remind you about.

# --- Database (required) ---
# Compose builds DATABASE_URL from these three; override DATABASE_URL directly
# if you run your own Postgres (needs the pgvector extension available).
POSTGRES_USER=pubrick
# Required in production-like installs: compose falls back to a weak default ('pubrick') if unset.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=pubrick

# --- Ports (optional) ---
# All three host ports below default to what past versions of this file hard-coded
# in docker-compose.yml (3000/3001/5432). Change one only if that port is already
# taken on your host — the single most common install failure is another Postgres
# already listening on 5432. The api and worker never use these; inside the
# compose network they always reach each other on the container's own port
# (postgres:5432, api:3001), regardless of what you set here.
#   WEB_PORT=3010          # the only one meant to be reachable from outside the
#                           # host — put your TLS terminator in front of it
#   API_HOST_PORT=3011     # localhost-only; for curling /api/health directly
#   POSTGRES_PORT=5433     # localhost-only; for connecting a host psql client —
#                           # `init.sh` (local dev) also needs this one free
# WEB_PORT=3000
# API_HOST_PORT=3001
# POSTGRES_PORT=5432

# --- API (optional) ---
# API_PORT applies only when running the api outside docker compose
# (init.sh / local dev): it is the api's own in-container listen port, not a
# host mapping — see API_HOST_PORT above for that. Compose pins this one to
# 3001 unconditionally (healthcheck and DATABASE_URL both assume it).
# API_PORT=3001

# --- Auth & crypto (REQUIRED — compose fails fast if either is unset) ---
# Generate a fresh value for EACH of the two (do not reuse one for both):
#
#   openssl rand -base64 32
#
# BETTER_AUTH_SECRET signs sessions; APP_ENCRYPTION_KEY encrypts channel and AI
# credentials at rest. Each key must base64-decode to exactly 32 bytes (the api
# refuses to boot otherwise). Losing it makes stored credentials unreadable —
# back it up.
# APP_ENCRYPTION_KEY is shared by the api and the worker (compose passes the
# same value to both): the worker decrypts the credentials the api encrypted,
# so the two must be identical — never generate a separate value per service.
#
# TO ROTATE, put the new key FIRST and keep the old one behind it, separated by
# a comma:
#
#   APP_ENCRYPTION_KEY=<new key>,<old key>
#
# Everything written from then on uses the new key; everything written before it
# is still read with the old one, so there is no window and nothing to run. Rows
# move to the new key as their channel's connection is tested or its credentials
# are re-saved; drop the old key once nothing is left on it. With a single key
# nothing moves: testing a connection leaves an existing row exactly as it was.
# When upgrading one service at a time, restart the worker BEFORE the api — the
# api writes credentials, the worker reads them (docs/self-hosting.md, Upgrade).
BETTER_AUTH_SECRET=REPLACE_ME_RUN_openssl_rand_base64_32
APP_ENCRYPTION_KEY=REPLACE_ME_RUN_openssl_rand_base64_32

# --- Public origin (REQUIRED — compose fails fast if unset) ---
# The origin a browser types, scheme included. Auth cookies, redirects and the
# trusted-origin list are all derived from it: get it wrong and every sign-in
# fails with a 403 "Invalid origin"; leave it on http:// behind TLS and session
# cookies ship without the Secure attribute.
PUBLIC_ORIGIN=http://localhost:3000

# --- Registration posture (optional) ---
# Who may create an account:
#   open    anyone with the URL — only for a trusted network
#   invite  only an address an existing member has invited (organization →
#           invite member); everyone else gets one generic refusal that does not
#           reveal whether the address is already registered
#   closed  nobody, same generic refusal
# Unset (the default) means AUTO: open while the instance has no account at all,
# invite-only from the moment the first one exists. That lets a fresh install
# create its own first account with no configuration, and closes the door
# afterwards without anyone having to remember to flip a setting back. The window
# is one account wide — register yours right after `docker compose up`, before
# pointing DNS at the box.
# SIGNUP_MODE=invite

# --- Auth rate limiting (optional) ---
# Sign-in / sign-up / change-password / change-email are capped at 3 requests per
# 10 s per client. Leave it on unless something in front of Pubrick already rate
# limits /api/auth.
# AUTH_RATE_LIMIT_ENABLED=true
# Comma-separated IPs or CIDR ranges of every proxy between the internet and
# Pubrick — your TLS terminator, a CDN's egress ranges. Pubrick reads the client
# address from X-Forwarded-For ONLY when this is set, because the web app's /api
# proxy passes a caller's own header through untouched: believing it unconditionally
# would let one attacker rotate the header and never be rate limited at all. While
# it is empty, auth rate limiting still works but shares one bucket per endpoint
# across all callers, and sessions record no IP address.
#   TRUSTED_PROXIES=127.0.0.1          # nginx/Caddy on the same host
#   TRUSTED_PROXIES=10.0.0.0/24        # a load balancer subnet
# TRUSTED_PROXIES=
